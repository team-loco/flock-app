#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

CLUSTERS=(fleet-a fleet-b flock-loco)
WAIT_TIMEOUT=300s
BUILD_TIMEOUT=600s
LOCO_COMPONENTS=(loco-controller loco-build-controller envoy-gateway loco-core-agent)
CONTROL_PLANE_COMPONENTS=(postgres loco-api)
AGENT_CONNECTED="sync stream connected"
APPLICATION_PHASES=(Ready Failed Deploying)
BUILD_PHASES=(Succeeded Failed Running)
GATEWAY_LABELS=gateway.envoyproxy.io/owning-gateway-name=eg,gateway.envoyproxy.io/owning-gateway-namespace=loco-system

verify_loco() {
  for deployment in "${LOCO_COMPONENTS[@]}"; do
    "${kubectl[@]}" -n loco-system rollout status "deployment/${deployment}" --timeout="${WAIT_TIMEOUT}"
  done
  for deployment in "${CONTROL_PLANE_COMPONENTS[@]}"; do
    "${kubectl[@]}" -n loco-control-plane rollout status "deployment/${deployment}" --timeout="${WAIT_TIMEOUT}"
  done
  agent_logs="$("${kubectl[@]}" -n loco-system logs deployment/loco-core-agent)"
  [[ "${agent_logs}" == *"${AGENT_CONNECTED}"* ]]
  "${kubectl[@]}" -n reports wait job/nightly-report-backfill --for=condition=Complete --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n loco-system wait deployment -l "${GATEWAY_LABELS}" --for=condition=Available --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n loco-system wait gateway/eg --for=condition=Accepted --timeout="${WAIT_TIMEOUT}"
  for phase in "${APPLICATION_PHASES[@]}"; do
    "${kubectl[@]}" -n loco-system wait applications -l "flock.dev/expect=${phase}" \
      --for=jsonpath='{.status.phase}'="${phase}" --timeout="${WAIT_TIMEOUT}"
  done
  for phase in "${BUILD_PHASES[@]}"; do
    "${kubectl[@]}" -n loco-builds wait builds -l "flock.dev/expect=${phase}" \
      --for=jsonpath='{.status.phase}'="${phase}" --timeout="${BUILD_TIMEOUT}"
  done
  "${kubectl[@]}" wait httproutes --all --all-namespaces \
    --for=jsonpath='{.status.parents[0].conditions[?(@.type=="Accepted")].status}'=True --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n ledger wait helmrelease/ledger-api --for=jsonpath='{.status.conditions[?(@.type=="Ready")].status}'=False --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n ledger wait helmrelease/ledger-migrations --for=jsonpath='{.status.conditions[?(@.type=="Ready")].status}'=Unknown --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n flux-system wait kustomization/rollouts --for=jsonpath='{.status.conditions[?(@.type=="Ready")].status}'=Unknown --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n flux-system wait kustomization/frozen-kustomization --for=jsonpath='{.spec.suspend}'=true --timeout="${WAIT_TIMEOUT}"
  python3 "${ROOT}/e2e/loco.py" --check <("${kubectl[@]}" get pods,applications --all-namespaces -o json)
}

for cluster in "${CLUSTERS[@]}"; do
  context="kind-${cluster}"
  kubectl=(mise exec -- kubectl --context "${context}")
  "${kubectl[@]}" -n kube-system rollout status deployment/metrics-server --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" wait apiservice/v1beta1.metrics.k8s.io --for=condition=Available --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n flux-system wait helmrepository/podinfo gitrepository/podinfo --for=condition=Ready --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n apps wait helmrelease/podinfo --for=condition=Ready --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n apps rollout status deployment/podinfo --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n flux-system wait helmchart --all --for=condition=Ready --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n flux-system wait kustomization/apps --for=condition=Ready --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n web wait deployment/podinfo --for=condition=Available --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n web rollout status deployment/podinfo --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n flux-system wait kustomization/broken-kustomization --for=jsonpath='{.status.conditions[?(@.type=="Ready")].reason}'=ArtifactFailed --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n search wait helmrelease/search-indexer --for=jsonpath='{.spec.suspend}'=true --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n payments wait pod -l app=stripe-webhook --for=jsonpath='{.status.containerStatuses[0].state.waiting.reason}'=CreateContainerConfigError --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n apps wait pod/unschedulable --for=jsonpath='{.status.phase}'=Pending --timeout="${WAIT_TIMEOUT}"
  "${kubectl[@]}" -n apps wait pod/unschedulable --for=jsonpath='{.status.conditions[?(@.type=="PodScheduled")].reason}'=Unschedulable --timeout="${WAIT_TIMEOUT}"
  scheduling_events="$("${kubectl[@]}" -n apps get events --field-selector involvedObject.name=unschedulable,reason=FailedScheduling -o name)"
  test -n "${scheduling_events}"
  if [[ "${cluster}" == fleet-a ]]; then
    "${kubectl[@]}" -n payments wait helmrelease/checkout-api --for=jsonpath='{.status.conditions[?(@.type=="Ready")].status}'=False --timeout="${WAIT_TIMEOUT}"
    "${kubectl[@]}" -n payments wait pod -l app.kubernetes.io/name=checkout-api --for=jsonpath='{.status.containerStatuses[0].state.waiting.reason}'=CrashLoopBackOff --timeout="${WAIT_TIMEOUT}"
    "${kubectl[@]}" -n apps wait pod/no-shell --for=condition=Ready --timeout="${WAIT_TIMEOUT}"
  else
    "${kubectl[@]}" -n payments wait helmrelease/checkout-api --for=condition=Ready --timeout="${WAIT_TIMEOUT}"
    "${kubectl[@]}" -n payments rollout status deployment/checkout-api --timeout="${WAIT_TIMEOUT}"
  fi
  if [[ "${cluster}" == flock-loco ]]; then
    verify_loco
  fi
  printf '%s: all scenario assertions passed\n' "${context}"
done
