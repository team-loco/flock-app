#!/usr/bin/env -S uv run --with fonttools python
#MISE description="Rebuild the Apache-2.0 Flock Status fonts from the 16px status icon paths"
import math
from pathlib import Path
import tomllib

from fontTools.fontBuilder import FontBuilder
from fontTools.ttLib import TTFont
from fontTools.pens.ttGlyphPen import TTGlyphPen

GRID = 16
GRID_CENTER = GRID / 2
ICON_BASELINE_OFFSET = 0.14
ARC_STEP = math.pi / 4
STROKE = 1.6
DOT_RADIUS = 3.6
SPINNER_RADIUS = 6
OFFLINE_RADIUS = 5.75
OFFLINE_DASH = 2.1
OFFLINE_GAP = 2.1
DIAMOND = [(8, 1.6), (14.4, 8), (8, 14.4), (1.6, 8)]
TRIANGLE = [(8, 2.2), (14.3, 13.25), (1.7, 13.25)]
WARNING_MARKS = [((8, 6.5), (8, 9.6)), ((8, 11.4), (8, 11.5))]
BARS = [((6, 3.75), (6, 12.25)), ((10, 3.75), (10, 12.25))]
TOP = -math.pi / 2
LOADER_PROBE = "m"
SPINNER_SWEEP = 3 * math.pi / 2
FONT_EPOCH = 2082844800
FAMILY = "Flock Status"
ROOT = Path(__file__).resolve().parents[2]
FONTS = ROOT / "crates/flock-ui/assets/fonts"
COPYRIGHT = "Copyright 2026 Flock contributors"
LICENSE = "Licensed under the Apache License, Version 2.0"
LICENSE_URL = "https://www.apache.org/licenses/LICENSE-2.0"


def polar(center, radius, angle):
    return (center[0] + radius * math.cos(angle), center[1] + radius * math.sin(angle))


def arc_points(center, radius, start, end):
    n = max(1, math.ceil(abs(end - start) / ARC_STEP - 1e-9))
    step = (end - start) / n
    control = radius / math.cos(step / 2)
    points = [(polar(center, radius, start), True)]
    for k in range(n):
        angle = start + k * step
        points.append((polar(center, control, angle + step / 2), False))
        points.append((polar(center, radius, angle + step), True))
    return points


def disc(center, radius):
    return arc_points(center, radius, TOP, TOP + 2 * math.pi)[:-1]


def polygon(points):
    return [(p, True) for p in points]


def line(start, end, width):
    dx, dy = end[0] - start[0], end[1] - start[1]
    length = math.hypot(dx, dy) or 1
    nx, ny = -dy / length * width / 2, dx / length * width / 2
    band = polygon([(start[0] + nx, start[1] + ny), (end[0] + nx, end[1] + ny),
                    (end[0] - nx, end[1] - ny), (start[0] - nx, start[1] - ny)])
    return [band, disc(start, width / 2), disc(end, width / 2)]


def arc(center, radius, start, end, width):
    outer = arc_points(center, radius + width / 2, start, end)
    inner = arc_points(center, radius - width / 2, end, start)
    caps = [disc(polar(center, radius, angle), width / 2) for angle in (start, end)]
    return [outer + inner, *caps]


def outline(points, width):
    edges = zip(points, points[1:] + points[:1])
    return [contour for a, b in edges for contour in line(a, b, width)]


def dashes(center, radius, width):
    circumference = 2 * math.pi * radius
    period = OFFLINE_DASH + OFFLINE_GAP
    count = math.ceil(circumference / period)
    spans = [(k * period, min(k * period + OFFLINE_DASH, circumference)) for k in range(count)]
    return [contour for a, b in spans
            for contour in arc(center, radius, TOP + a / radius, TOP + b / radius, width)]


def shapes():
    center = (GRID_CENTER, GRID_CENTER)
    return {
        "✕": [polygon(DIAMOND)],
        "▲": outline(TRIANGLE, STROKE)
             + [contour for a, b in WARNING_MARKS for contour in line(a, b, STROKE)],
        "●": [disc(center, DOT_RADIUS)],
        "◐": arc(center, SPINNER_RADIUS, TOP, TOP + SPINNER_SWEEP, STROKE),
        "‖": [contour for a, b in BARS for contour in line(a, b, STROKE)],
        "○": dashes(center, OFFLINE_RADIUS, STROKE),
    }


def to_font(contour, upm):
    scale = upm / GRID
    top = upm * (1 - ICON_BASELINE_OFFSET)
    points = [((x * scale, top - y * scale), on) for (x, y), on in contour]
    area = sum(a[0] * b[1] - b[0] * a[1]
               for (a, _), (b, _) in zip(points, points[1:] + points[:1]))
    return points[::-1] if area > 0 else points


def draw(contours, upm):
    pen = TTGlyphPen(None)
    for contour in contours:
        points = to_font(contour, upm)
        start = next(i for i, (_, on) in enumerate(points) if on)
        points = points[start:] + points[:start]
        pen.moveTo(points[0][0])
        pending = []
        for point, on in points[1:] + points[:1]:
            if on:
                if pending:
                    pen.qCurveTo(*pending, point)
                    pending = []
                else:
                    pen.lineTo(point)
            else:
                pending.append(point)
        pen.closePath()
    glyph = pen.glyph()
    glyph.flags[0] |= 0x40
    return glyph


def generate(weight, version):
    reference = TTFont(FONTS / f"IBMPlexMono-{weight}.ttf")
    upm = reference["head"].unitsPerEm
    glyphs = {ord(character): draw(contours, upm) for character, contours in shapes().items()}
    glyphs[ord(LOADER_PROBE)] = TTGlyphPen(None).glyph()
    names = {cp: f"uni{cp:04X}" for cp in glyphs}
    order = [".notdef", *names.values()]
    outlines = {names[cp]: glyph for cp, glyph in glyphs.items()}
    outlines[".notdef"] = TTGlyphPen(None).glyph()
    font = FontBuilder(upm, isTTF=True)
    font.setupGlyphOrder(order)
    font.setupCharacterMap(names)
    font.setupGlyf(outlines)
    glyf = font.font["glyf"]
    metrics = {name: (upm, getattr(glyf[name], "xMin", 0)) for name in order}
    font.setupHorizontalMetrics(metrics)
    horizontal = reference["hhea"]
    font.setupHorizontalHeader(ascent=horizontal.ascent, descent=horizontal.descent,
                               lineGap=horizontal.lineGap)
    font.setupNameTable({
        "familyName": FAMILY,
        "styleName": weight,
        "typographicFamily": FAMILY,
        "typographicSubfamily": weight,
        "uniqueFontIdentifier": f"FlockStatus-{weight}-{version}",
        "fullName": f"{FAMILY} {weight}",
        "psName": f"FlockStatus-{weight}",
        "version": f"Version {version}",
        "copyright": COPYRIGHT,
        "licenseDescription": LICENSE,
        "licenseInfoURL": LICENSE_URL,
    })
    os2 = reference["OS/2"]
    font.setupOS2(version=os2.version, sTypoAscender=os2.sTypoAscender, sTypoDescender=os2.sTypoDescender,
                  sTypoLineGap=os2.sTypoLineGap, usWinAscent=os2.usWinAscent,
                  usWinDescent=os2.usWinDescent, sxHeight=os2.sxHeight,
                  sCapHeight=os2.sCapHeight, usWeightClass=os2.usWeightClass,
                  fsSelection=os2.fsSelection)
    font.setupPost(isFixedPitch=True)
    font.setupMaxp()
    font.font["head"].created = FONT_EPOCH
    font.font["head"].modified = FONT_EPOCH
    font.font.recalcTimestamp = False
    filename = "FlockStatus.ttf" if weight == "Regular" else "FlockStatus-Medium.ttf"
    font.save(FONTS / filename)


with (ROOT / "Cargo.toml").open("rb") as manifest:
    version = tomllib.load(manifest)["workspace"]["package"]["version"]
generate("Regular", version)
generate("Medium", version)
