#!/usr/bin/env bash
#MISE description="Prove Flock works against the kind scenario clusters: up, verify, run every FLOCK_E2E test"
#USAGE flag "--skip-up" help="Do not create the clusters; require them to exist and reset their scenarios"
#USAGE flag "--no-teardown" help="Keep the clusters after the run (the default outside CI)"
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CLUSTERS=(fleet-a fleet-b flock-loco)
BUILD_LOG_TAIL=80
skip_up="${usage_skip_up:-false}"
no_teardown="${usage_no_teardown:-false}"

teardown() {
  if [[ "${no_teardown}" != true && -n "${CI:-}" ]]; then
    "${ROOT}/mise-tasks/e2e/down"
  fi
}
stop_tree() {
  local child
  for child in $(pgrep -P "$1"); do
    stop_tree "${child}"
  done
  kill "$1" 2>/dev/null || true
}

stop_build() {
  if [[ -n "${build_pid:-}" ]] && kill -0 "${build_pid}" 2>/dev/null; then
    stop_tree "${build_pid}"
  fi
}
work_dir="$(mktemp -d)"
trap 'stop_build; teardown; rm -rf "${work_dir}"' EXIT

cd "${ROOT}"
test_scope=(--workspace)
loco_feature=flock-shots/loco
if [[ "$(uname -s)" != Darwin ]]; then
  test_scope+=(--exclude flock --exclude flock-bench --exclude flock-shots --exclude flock-ui --exclude flock-update)
  loco_feature=flock-kube/loco,flock-demo/loco
fi
build_log="${work_dir}/build.log"
{
  mise exec -- cargo nextest run "${test_scope[@]}" --no-run \
    && mise exec -- cargo nextest run "${test_scope[@]}" --no-run --features "${loco_feature}"
} >"${build_log}" 2>&1 &
build_pid="$!"

kubeconfigs=()
for cluster in "${CLUSTERS[@]}"; do
  kubeconfigs+=("${work_dir}/${cluster}.kubeconfig")
done
KUBECONFIG="$(IFS=:; printf '%s' "${kubeconfigs[*]}")"
export KUBECONFIG

if [[ "${skip_up}" != true ]]; then
  "${ROOT}/mise-tasks/e2e/up"
fi

for cluster in "${CLUSTERS[@]}"; do
  file="${work_dir}/${cluster}.kubeconfig"
  mise exec -- kind get kubeconfig --name "${cluster}" >"${file}"
done

if [[ "${skip_up}" == true ]]; then
  for cluster in "${CLUSTERS[@]}"; do
    "${ROOT}/e2e/reset" "${cluster}"
  done
  "${ROOT}/e2e/verify"
fi

if ! wait "${build_pid}"; then
  printf 'test build failed, last %s lines:\n' "${BUILD_LOG_TAIL}" >&2
  tail -n "${BUILD_LOG_TAIL}" "${build_log}" >&2
  exit 1
fi

export FLOCK_E2E=1
mise exec -- cargo nextest run "${test_scope[@]}" --no-tests=pass
mise exec -- cargo nextest run "${test_scope[@]}" --no-tests=pass --features "${loco_feature}"
