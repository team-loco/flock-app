#!/usr/bin/env bash
#MISE description="Render a demo screen to a PNG headlessly: mise run shot -- <screen> [dark|light]"
#USAGE arg "<screen>" help="flock, fleet-problems, cluster, collapsed, switcher, command, changes, compare, edit-yaml, cluster-settings, settings, gitops, overview, nodes, namespaces, namespace, events, resources, resource-inspector, job, node, kit, kit-overlays, kit-panes, add-cluster, add-cluster-check, workload, split, pods, pods-shell, nodes-shell, logs, kustomization, helmrelease, source, flux-graph, flux-events, custom-resources, custom-resource-inspector, helm-releases or helm-release; with FLOCK_FEATURES=loco also loco-platform, loco-apps, loco-builds or loco-routes"
#USAGE arg "[appearance]" default="dark" help="dark or light"
#USAGE flag "--state <state>" help="loading, connecting, empty, error, metrics-local, metrics-empty or metrics-error: render the screen in that page state"
#USAGE flag "--primary <highlight>" help="primary highlight: blue, purple, teal, green, orange, pink, graphite or a #hex colour"
#USAGE flag "--secondary <highlight>" help="secondary highlight: a preset name or a #hex colour"
set -euo pipefail

screen="${usage_screen:-${1:?screen}}"
appearance="${usage_appearance:-${2:-dark}}"
root="$(git rev-parse --show-toplevel)"
state="${usage_state:-}"
primary="${usage_primary:-}"
secondary="${usage_secondary:-}"
tag="${primary:+-${primary#\#}}${secondary:+-sel-${secondary#\#}}"
out="$root/target/shots/$screen${state:+-$state}$tag-$appearance.png"

cargo run -p flock-shots --quiet ${FLOCK_FEATURES:+--features "$FLOCK_FEATURES"} -- "$screen" "$appearance" --out "$out" \
  ${state:+--state "$state"} ${primary:+--primary "$primary"} ${secondary:+--secondary "$secondary"}
